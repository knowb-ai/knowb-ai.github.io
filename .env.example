# Copy this file to .env. The real .env is ignored and must never be committed.
# Existing shell variables take precedence over values in this file.

# Optional local registry override.
# KNOWB_ORG_CONFIG=/absolute/path/to/knowb-ai.github.io/config/local-projects.yml

# Optional repository root override when the package is launched elsewhere.
# KNOWB_ORG_ROOT=/absolute/path/to/knowb-ai.github.io

# Optional explicit env-file path. Usually leave this unset.
# KNOWB_ENV_FILE=/absolute/path/to/knowb-ai.github.io/.env

# Google OAuth desktop-app configuration. The browser flow stores the refresh
# grant in macOS Keychain; no access token or refresh token belongs in .env.
# Use either the client ID directly or a downloaded Desktop OAuth JSON file.
KNOWB_GOOGLE_OAUTH_CLIENT_ID=
# KNOWB_GOOGLE_OAUTH_CLIENT_FILE=/absolute/path/to/google-desktop-client.json
# Optional for desktop clients; PKCE remains required.
# KNOWB_GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override; the default Drive scope is required for folder reads/uploads.
# KNOWB_GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive
